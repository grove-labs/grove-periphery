# JSON-RPC endpoint for Ethereum mainnet.
# Required by `forge test` (the suite forks mainnet) and by deployment (`--rpc-url mainnet`).
MAINNET_RPC_URL=

# Etherscan API key. Optional, only needed to verify contracts during deployment (`--verify`).
ETHERSCAN_API_KEY=

# Custom deployment (DeployInstantUsdcUsdsConverterCustom). All six are required only when
# running the custom, env-driven deploy script; use addresses valid on the target chain.
# The same six are also read by the custom verification script.
CONVERTER_ADMIN=
CONVERTER_SWAPPER=
CONVERTER_PAUSER=
CONVERTER_HOLDER=
CONVERTER_LITE_PSM=
CONVERTER_DAI_USDS=

# Post-deployment verification. Address of the deployed InstantUsdcUsdsConverter to verify.
CONVERTER_ADDRESS=
